<Window x:Class="Stardust.Paradox.GremlinStudio.Dialogs.EditConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Stardust.Paradox.GremlinStudio.Controls"
        xmlns:converters="clr-namespace:Stardust.Paradox.GremlinStudio.Converters"
        mc:Ignorable="d"
        Title="Edit Connection" 
        Height="480" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        ResizeMode="NoResize">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" 
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        
        <!-- Dialog Caption Button Style -->
        <Style x:Key="DialogCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1707A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border Background="{DynamicResource PrimaryBackgroundBrush}" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                   VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Edit Connection" FontWeight="SemiBold" FontSize="12" 
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </StackPanel>
                    
                    <Border Grid.Column="1" Background="Transparent"/>
                    
                    <Button Grid.Column="2" Content="&#xE106;" 
                            Style="{StaticResource DialogCaptionButtonStyle}" 
                            Click="CloseButton_Click" 
                            ToolTip="Close"/>
                </Grid>
            </Border>
            
            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="{Binding ConnectionName}" FontSize="18" FontWeight="SemiBold" 
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding KindDescription}" FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                
                <!-- Connection Fields -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Common: Name -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Name" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding ConnectionName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource TertiaryBackgroundBrush}" 
                                     Foreground="{DynamicResource PrimaryForegroundBrush}" 
                                     BorderBrush="{DynamicResource BorderBrush}"/>
                        </Grid>
                        
                        <!-- Server fields (hidden for InMemory) -->
                        <StackPanel Visibility="{Binding IsServerConnection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Host" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBox Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource TertiaryBackgroundBrush}" 
                                         Foreground="{DynamicResource PrimaryForegroundBrush}" 
                                         BorderBrush="{DynamicResource BorderBrush}"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Port" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBox Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource TertiaryBackgroundBrush}" 
                                         Foreground="{DynamicResource PrimaryForegroundBrush}" 
                                         BorderBrush="{DynamicResource BorderBrush}"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Username" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBox Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource TertiaryBackgroundBrush}" 
                                         Foreground="{DynamicResource PrimaryForegroundBrush}" 
                                         BorderBrush="{DynamicResource BorderBrush}"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Secret" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <PasswordBox Grid.Column="1" x:Name="PasswordBox"
                                             controls:PasswordBoxHelper.BoundPassword="{Binding Secret, Mode=TwoWay}"
                                             Background="{DynamicResource TertiaryBackgroundBrush}" 
                                             Foreground="{DynamicResource PrimaryForegroundBrush}" 
                                             BorderBrush="{DynamicResource BorderBrush}"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Database" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBox Grid.Column="1" Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource TertiaryBackgroundBrush}" 
                                         Foreground="{DynamicResource PrimaryForegroundBrush}" 
                                         BorderBrush="{DynamicResource BorderBrush}"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Graph" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBox Grid.Column="1" Text="{Binding Graph, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource TertiaryBackgroundBrush}" 
                                         Foreground="{DynamicResource PrimaryForegroundBrush}" 
                                         BorderBrush="{DynamicResource BorderBrush}"/>
                            </Grid>
                        </StackPanel>
                        
                        <!-- InMemory info -->
                        <StackPanel Visibility="{Binding IsServerConnection, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                    Margin="0,4,0,0">
                            <Border Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="InMemory Playground" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                        <Run Text="Scenario: "/>
                                        <Run Text="{Binding ScenarioDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="Use Reset on the main panel to reload initial data" 
                                               FontSize="10" FontStyle="Italic" 
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        
                        <!-- Error message -->
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#E81123" TextWrapping="Wrap" 
                                   Margin="0,12,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </ScrollViewer>
                
                <!-- Footer Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Test" Command="{Binding TestCommand}" Width="70" Margin="0,0,8,0"
                            Visibility="{Binding IsServerConnection, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Save" Command="{Binding SaveCommand}" Width="80" Margin="0,0,8,0"/>
                    <Button Content="Cancel" IsCancel="True" Width="80" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
