<Window x:Class="Stardust.Paradox.GremlinStudio.Dialogs.KeyboardShortcutsDialog"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Keyboard Shortcuts" 
Height="520" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Background="{DynamicResource PrimaryBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DialogCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1707A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PrimaryBackgroundBrush}" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Keyboard Shortcuts" FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#xE106;"
                            Style="{StaticResource DialogCaptionButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Close"/>
                </Grid>
            </Border>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" Margin="16,12" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Query Execution Section -->
                    <TextBlock Text="Query Execution" FontWeight="SemiBold" FontSize="13" 
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                    
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Ctrl+Enter" FontFamily="Consolas" FontSize="12" 
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Execute query" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>
                    
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="F5" FontFamily="Consolas" FontSize="12" 
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Execute query" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>
                    
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Escape" FontFamily="Consolas" FontSize="12" 
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Cancel running query" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>
                    
                    <!-- Editor Section -->
                    <TextBlock Text="Query Editor" FontWeight="SemiBold" FontSize="13" 
                               Foreground="{DynamicResource AccentBrush}" Margin="0,16,0,8"/>
                    
                    
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Tab" FontFamily="Consolas" FontSize="12" 
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Show autocomplete suggestions" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>
                    
                    <!-- View Section -->
                    <TextBlock Text="View" FontWeight="SemiBold" FontSize="13" 
                               Foreground="{DynamicResource AccentBrush}" Margin="0,16,0,8"/>
                    
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Ctrl+B" FontFamily="Consolas" FontSize="12" 
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Toggle settings panel" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>

                    <!-- Editor Section -->
                    <TextBlock Text="Editor" FontWeight="SemiBold" FontSize="13" 
                               Foreground="{DynamicResource AccentBrush}" Margin="0,16,0,8"/>
                    <ItemsControl>
                        <ItemsControl.Resources>
                            <Style TargetType="ContentControl">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ContentControl">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.Resources>
                        <ContentControl Tag="Ctrl+Space" Content="Show completion"/>
                        <ContentControl Tag="Ctrl+Shift+Space" Content="Show parameter info"/>
                        <ContentControl Tag="Tab" Content="Expand snippet (vl, el, vid, vc, rep, addv, ...)"/>
                        <ContentControl Tag="Ctrl+/" Content="Toggle line comment"/>
                        <ContentControl Tag="Ctrl+D" Content="Duplicate line/selection"/>
                        <ContentControl Tag="Alt+Up/Down" Content="Move line(s) up/down"/>
                        <ContentControl Tag="Ctrl+Shift+M" Content="Toggle all foldings"/>
                        <ContentControl Tag="Ctrl+Shift+P" Content="Command palette"/>
                        <ContentControl Tag="Ctrl+Shift+K" Content="Pin result to new tab"/>
                    </ItemsControl>

                    <!-- Help Section -->
                    <TextBlock Text="Help" FontWeight="SemiBold" FontSize="13" 
                               Foreground="{DynamicResource AccentBrush}" Margin="0,16,0,8"/>
                    
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="F1" FontFamily="Consolas" FontSize="12" 
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Show this help dialog" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>
                    
                    <!-- Graph View Section -->
                    <TextBlock Text="Graph View" FontWeight="SemiBold" FontSize="13" 
                               Foreground="{DynamicResource AccentBrush}" Margin="0,16,0,8"/>
                    
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Mouse drag" FontFamily="Consolas" FontSize="12" 
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Pan the graph canvas" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>
                    
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Click node" FontFamily="Consolas" FontSize="12" 
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Select and drag node" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>
                    
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Click edge" FontFamily="Consolas" FontSize="12" 
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Select edge and view properties" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>
                    
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Scroll" FontFamily="Consolas" FontSize="12" 
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Pan graph up/down" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>
                    
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Shift+Scroll" FontFamily="Consolas" FontSize="12" 
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Pan graph left/right" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>
                    
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Ctrl+Scroll" FontFamily="Consolas" FontSize="12" 
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Zoom in/out" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource SecondaryBackgroundBrush}" 
                    Padding="16,12">
                <Button Content="Close" HorizontalAlignment="Right" Padding="20,8" 
                        Click="CloseButton_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
