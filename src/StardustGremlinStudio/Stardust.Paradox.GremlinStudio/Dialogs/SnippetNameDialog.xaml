<Window x:Class="Stardust.Paradox.GremlinStudio.Dialogs.SnippetNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save as Snippet"
        Width="400" Height="180"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Enter a name for this snippet:" FontSize="13" Margin="0,0,0,8"/>
        <TextBox x:Name="SnippetNameTextBox" Grid.Row="1" FontSize="13" Padding="8,6"
                 Background="{DynamicResource InputBackgroundBrush}"
                 Foreground="{DynamicResource InputForegroundBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 KeyDown="SnippetNameTextBox_KeyDown"/>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Width="80" Padding="8,6" Click="SaveButton_Click" IsDefault="True"
                    Background="{DynamicResource AccentBrush}" Foreground="White"/>
            <Button Content="Cancel" Width="80" Padding="8,6" Margin="8,0,0,0" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
