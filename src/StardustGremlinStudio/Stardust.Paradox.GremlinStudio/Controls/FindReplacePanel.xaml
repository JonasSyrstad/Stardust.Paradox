<UserControl x:Class="Stardust.Paradox.GremlinStudio.Controls.FindReplacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Border Background="{DynamicResource TertiaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="0"
            MinWidth="340">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Drag Handle Bar -->
            <Border x:Name="DragHandle" Grid.Row="0" Background="{DynamicResource TertiaryBackgroundBrush}"
                    CornerRadius="6,6,0,0" Cursor="SizeAll" Padding="10,6,10,4"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                    MouseMove="DragHandle_MouseMove"
                    MouseLeftButtonUp="DragHandle_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Grip dots -->
                    <TextBlock Grid.Column="0" Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"
                               Opacity="0.5"/>
                    <TextBlock Grid.Column="1" Text="Find and Replace" FontSize="11" Margin="6,0,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" ToolTip="Close (Escape)"
                            Click="Close_Click" Width="22" Height="22"
                            Padding="0" Background="Transparent"
                            Foreground="{DynamicResource SecondaryForegroundBrush}" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="10,4,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Toggle Replace Row button -->
                <Button x:Name="ToggleReplaceButton" Grid.Column="0"
                        ToolTip="Toggle Replace (Ctrl+H)"
                        Click="ToggleReplace_Click"
                        Width="22" Height="22" Margin="0,0,6,0"
                        VerticalAlignment="Top"
                        Padding="0" Background="Transparent"
                        Foreground="{DynamicResource PrimaryForegroundBrush}" BorderThickness="0" Cursor="Hand">
                    <TextBlock x:Name="ToggleReplaceIcon" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                
                <StackPanel Grid.Column="1">
                    <!-- Find Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FindTextBox"
                                 Grid.Column="0"
                                 Padding="6,4" FontSize="12" FontFamily="Consolas"
                                 Background="{DynamicResource EditorBackgroundBrush}"
                                 Foreground="{DynamicResource EditorForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 CaretBrush="{DynamicResource PrimaryForegroundBrush}"
                                 KeyDown="FindTextBox_KeyDown"
                                 TextChanged="FindTextBox_TextChanged"/>
                        <Button Grid.Column="1" ToolTip="Previous (Shift+Enter)"
                                Click="FindPrevious_Click" Width="26" Height="26" Margin="4,0,0,0"
                                Padding="0" Background="Transparent"
                                Foreground="{DynamicResource PrimaryForegroundBrush}" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                        <Button Grid.Column="2" ToolTip="Next (Enter)"
                                Click="FindNext_Click" Width="26" Height="26" Margin="2,0,0,0"
                                Padding="0" Background="Transparent"
                                Foreground="{DynamicResource PrimaryForegroundBrush}" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                    </Grid>

                    <!-- Replace Row (collapsible) -->
                    <Grid x:Name="ReplaceRow" Margin="0,6,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ReplaceTextBox"
                                 Grid.Column="0"
                                 Padding="6,4" FontSize="12" FontFamily="Consolas"
                                 Background="{DynamicResource EditorBackgroundBrush}"
                                 Foreground="{DynamicResource EditorForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 CaretBrush="{DynamicResource PrimaryForegroundBrush}"
                                 KeyDown="ReplaceTextBox_KeyDown"/>
                        <Button Grid.Column="1" ToolTip="Replace current match"
                                Click="Replace_Click" Height="26" Margin="4,0,0,0"
                                Padding="6,0" FontSize="11"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource ButtonForegroundBrush}" BorderThickness="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Replace" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" ToolTip="Replace all matches"
                                Click="ReplaceAll_Click" Height="26" Margin="2,0,0,0"
                                Padding="6,0" FontSize="11"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource ButtonForegroundBrush}" BorderThickness="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B3;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="All" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Status Row -->
                    <TextBlock x:Name="StatusText" Margin="0,4,0,0"
                               FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
