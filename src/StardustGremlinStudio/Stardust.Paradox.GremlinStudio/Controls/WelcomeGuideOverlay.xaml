<UserControl x:Class="Stardust.Paradox.GremlinStudio.Controls.WelcomeGuideOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Stardust.Paradox.GremlinStudio.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="600">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <!-- Full-screen overlay with Canvas for absolute positioning -->
    <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <!-- Semi-transparent backdrop -->
        <Border Background="#88000000" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown"/>

        <!-- Positioned chat bubble -->
        <Canvas x:Name="BubbleCanvas">
            <Border x:Name="BubbleBorder"
                    Canvas.Left="{Binding BubbleLeft}"
                    Canvas.Top="{Binding BubbleTop}"
                    MaxWidth="360" MinWidth="280"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="2"
                    CornerRadius="12"
                    Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="Black"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header with step counter and close -->
                    <Border Grid.Row="0" Background="{DynamicResource TertiaryBackgroundBrush}"
                            CornerRadius="10,10,0,0" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding GuideTitle}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1" Text="{Binding StepProgressText}"
                                       FontSize="11" Margin="8,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="2" Content="&#xE10A;" FontFamily="Segoe MDL2 Assets"
                                    Width="22" Height="22" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource SecondaryForegroundBrush}"
                                    Command="{Binding SkipGuideCommand}"
                                    Cursor="Hand" FontSize="10"
                                    ToolTip="Skip guide"/>
                        </Grid>
                    </Border>

                    <!-- Bubble content -->
                    <StackPanel Grid.Row="1" Margin="16,14,16,10">
                        <TextBlock Text="{Binding CurrentStep.Title}"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding CurrentStep.Description}"
                                   FontSize="12" LineHeight="18"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   TextWrapping="Wrap"/>

                        <!-- New Feature Badge -->
                        <Border Visibility="{Binding IsNewFeaturesMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="#2200AAFF" BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="6,3" HorizontalAlignment="Left"
                                Margin="0,8,0,0">
                            <TextBlock Text="{Binding CurrentStep.FeatureVersion, StringFormat='New in v{0}'}"
                                       FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Footer navigation -->
                    <Border Grid.Row="2" Background="{DynamicResource TertiaryBackgroundBrush}"
                            CornerRadius="0,0,10,10" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Skip"
                                    Command="{Binding SkipGuideCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource SecondaryForegroundBrush}"
                                    Padding="6,4" Cursor="Hand" FontSize="11"/>

                            <Button Grid.Column="2"
                                    Command="{Binding PreviousStepCommand}"
                                    IsEnabled="{Binding CanGoPrevious}"
                                    Padding="8,5" Margin="0,0,6,0" FontSize="11"
                                    ToolTip="Previous">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Prev" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3"
                                    Command="{Binding NextStepCommand}"
                                    Padding="10,5" FontSize="11" FontWeight="SemiBold"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="NextIcon" Text="Next" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="NextArrow" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Arrow pointer (a triangle drawn via Polygon, positioned by code-behind) -->
            <Polygon x:Name="BubbleArrow"
                     Fill="{DynamicResource AccentBrush}"
                     Points="0,0 14,0 7,10"
                     Canvas.Left="0" Canvas.Top="0"/>
        </Canvas>
    </Grid>
</UserControl>
