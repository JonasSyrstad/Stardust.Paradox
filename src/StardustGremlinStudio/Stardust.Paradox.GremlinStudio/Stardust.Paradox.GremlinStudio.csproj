<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Remove="Resources\analyzer.png" />
    <None Remove="Resources\progress.png" />
    <None Remove="Resources\splash2.png" />
    <None Remove="Resources\splash3.png" />
    <None Remove="Resources\splash4.png" />
    <None Remove="Resources\splash5.png" />
    <None Remove="Resources\splash6.png" />
    <None Remove="Resources\splash7.png" />
    <None Remove="Resources\splash8.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stardust.Paradox.GremlinStudio.Core\Stardust.Paradox.GremlinStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <RootNamespace>Stardust.Paradox.GremlinStudio</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    
    
    <!-- Application Metadata -->
    <AssemblyName>GremlinStudio</AssemblyName>
    <Product>Stardust Gremlin Studio</Product>
    <Company>Stardust</Company>
    <Authors>Jonas Syrstad</Authors>
    <Description>A modern, feature-rich query tool for Gremlin-based graph databases including Azure Cosmos DB and Apache TinkerPop.</Description>
    <Copyright>Copyright © 2024 Jonas Syrstad. All rights reserved.</Copyright>
    <Version>1.2.6</Version>
    <FileVersion>1.2.6.0</FileVersion>
    <AssemblyVersion>1.2.6.0</AssemblyVersion>
    
    <!-- Application Icon -->
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    
    <!-- Publishing Settings -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\analyzer.png" />
    <Resource Include="Resources\icon.png" />
    <Resource Include="Resources\progress.png" />
    <Resource Include="Resources\splash.png" />
    <Resource Include="Resources\splash2.png" />
    <Resource Include="Resources\splash3.png" />
    <Resource Include="Resources\splash4.png" />
    <Resource Include="Resources\splash5.png" />
    <Resource Include="Resources\splash6.png" />
    <Resource Include="Resources\splash7.png" />
    <Resource Include="Resources\splash8.png" />
  </ItemGroup>

</Project>

