<Window x:Class="Stardust.Paradox.GremlinStudio.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
xmlns:controls="clr-namespace:Stardust.Paradox.GremlinStudio.Controls"
xmlns:converters="clr-namespace:Stardust.Paradox.GremlinStudio.Converters"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:Stardust.Paradox.GremlinStudio"
mc:Ignorable="d"
Title="Stardust Gremlin Studio" Height="720" Width="1200"
Icon="/Resources/icon.png"
WindowStyle="None"
AllowsTransparency="True"
Background="Transparent"
Foreground="{DynamicResource PrimaryForegroundBrush}">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" 
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    
    
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding RunQueryCommand}" />
        <KeyBinding Key="F5" Command="{Binding RunQueryCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="F1" Command="{Binding ShowKeyboardShortcutsCommand}" />
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding ToggleSettingsPanelCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveQueryCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveQueryAsCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenQueryCommand}" />
        <KeyBinding Key="F" Modifiers="Ctrl+Shift" Command="{Binding FormatQueryCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExplainQueryCommand}" />
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding ResolveParametersCommand}" />
    </Window.InputBindings>
    
<Window.Resources>
<converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
<converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
<converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
<converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
<converters:BoolToEdgeColorConverter x:Key="BoolToEdgeColorConverter"/>
<converters:BoolToEdgeThicknessConverter x:Key="BoolToEdgeThicknessConverter"/>
<converters:BoolToLabelBackgroundConverter x:Key="BoolToLabelBackgroundConverter"/>
<converters:BoolToPinTooltipConverter x:Key="BoolToPinTooltipConverter"/>
<converters:EqualityConverter x:Key="EqualityConverter"/>
<converters:ExportFormatToSyntaxModeConverter x:Key="ExportFormatToSyntaxModeConverter"/>
<converters:ProgressToWidthConverter x:Key="ProgressToWidthConverter"/>
<converters:BoolToStatusColorConverter x:Key="BoolToStatusColorConverter"/>



<!-- Modern Window Caption Button Style -->
<Style x:Key="CaptionButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="border" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="border" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="border" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="border" Property="Background" Value="#E81123"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="border" Property="Background" Value="#F1707A"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>
    
<!-- DataGrid Column Header Style for better contrast -->
<Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
</Style>

<!-- Modern Button Style -->
<Style TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<!-- Compact Button Style for small action buttons -->
<Style x:Key="CompactButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="6,6"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<!-- Icon Button Style for panel collapse/expand -->
<Style x:Key="IconButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="border" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<!-- Modern TextBox Style -->
<Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="TextBox">
                <Border x:Name="border" 
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </Trigger>
                    <Trigger Property="IsFocused" Value="True">
                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<!-- Modern PasswordBox Style -->
<Style TargetType="PasswordBox">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="PasswordBox">
                <Border x:Name="border" 
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </Trigger>
                    <Trigger Property="IsFocused" Value="True">
                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<!-- Modern ListBoxItem Style -->
<Style TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Margin" Value="2"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<!-- Modern ListBox Style -->
<Style TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="ListBox">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">
                    <ScrollViewer Focusable="False">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<!-- Modern TabItem Style -->
<Style TargetType="TabItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="TabItem">
                <Grid>
                    <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6,6,0,0">
                        <ContentPresenter x:Name="ContentSite" ContentSource="Header" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="Indicator" Height="3" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}" CornerRadius="2" Visibility="Collapsed" Margin="8,0"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
                        <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<!-- Modern GroupBox Style -->
<Style TargetType="GroupBox">
    <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="GroupBox">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="8,8,0,0" Padding="14,10">
                        <ContentPresenter ContentSource="Header" TextBlock.FontWeight="SemiBold" TextBlock.FontSize="13"/>
                    </Border>
                    <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<!-- Modern Separator Style -->
<Style TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="0,12"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Separator">
                <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" CornerRadius="1"/>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

</Window.Resources>
    
<Border x:Name="WindowBorder" Background="{DynamicResource PrimaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
    <Border.Style>
        <Style TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="CornerRadius" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Border.Style>
<Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    
    <!-- Modern Custom Title Bar -->
    <Border Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="8,8,0,0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- App Icon and Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Image Source="/Resources/icon.png" Width="18" Height="18" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Stardust Gremlin Studio" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
            </StackPanel>
            
            <!-- Draggable Area -->
            <Border Grid.Column="1" Background="Transparent"/>
            
            <!-- Window Control Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <!-- Welcome Guide Button -->
                <Button x:Name="GuideTarget_ShortcutsHint" Style="{StaticResource CaptionButtonStyle}" 
                        Command="{Binding ShowWelcomeGuideCommand}"
                        ToolTip="Welcome Guide">
                    <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                <!-- Update Download Progress -->
                <Border Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="Transparent" VerticalAlignment="Center" Margin="8,0" Width="100">
                    <Grid>
                        <ProgressBar Value="{Binding UpdateDownloadProgress}" Minimum="0" Maximum="100" Height="4" 
                                     Background="{DynamicResource TertiaryBackgroundBrush}" 
                                     Foreground="{DynamicResource AccentBrush}"/>
                    </Grid>
                </Border>
                <!-- Update Pane Toggle Button -->
                <Button x:Name="UpdatePaneButton" Style="{StaticResource CaptionButtonStyle}" 
                        Command="{Binding ToggleUpdatePaneCommand}"
                        ToolTip="Application updates">
                    <Grid>
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <!-- Notification dot when update is available -->
                        <Ellipse Width="7" Height="7" Fill="#FF5722" Margin="12,-10,0,0" 
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Button>
                <Popup x:Name="UpdatePanePopup"
                       PlacementTarget="{Binding ElementName=UpdatePaneButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       IsOpen="{Binding IsUpdatePaneOpen, Mode=TwoWay}">
                    <Border Background="{DynamicResource SecondaryBackgroundBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" CornerRadius="8" 
                            Padding="16" Width="300"
                            Margin="0,4,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Header -->
                            <TextBlock Text="Application Updates" FontWeight="SemiBold" FontSize="14" 
                                       Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,0,12"/>
                            
                            <!-- Current Version -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Current version:" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding CurrentVersion}" Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"/>
                            </StackPanel>
                            
                            <Separator Margin="0,0,0,12"/>
                            
                            <!-- Update Available Section -->
                            <StackPanel Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                               Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="12" VerticalAlignment="Center">
                                        <Run Text="Version"/><Run Text=" "/><Run Text="{Binding UpdateVersion, Mode=OneWay}"/><Run Text=" is available!"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Content="Download &amp; Install" 
                                        Command="{Binding DownloadAndApplyUpdateCommand}"
                                        HorizontalAlignment="Stretch" Padding="10,8"
                                        Background="{DynamicResource AccentBrush}" Foreground="White"/>
                            </StackPanel>
                            
                            <!-- Download Progress Section -->
                            <StackPanel Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,8">
                                <TextBlock Text="Downloading update..." Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="12" Margin="0,0,0,6"/>
                                <ProgressBar Value="{Binding UpdateDownloadProgress}" Minimum="0" Maximum="100" Height="6" 
                                             Background="{DynamicResource TertiaryBackgroundBrush}" 
                                             Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="11" Margin="0,4,0,0"
                                           Text="{Binding UpdateDownloadProgress, StringFormat='{}{0}%'}"/>
                            </StackPanel>
                            
                            <!-- Checking indicator -->
                            <StackPanel Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource BoolToVisibilityConverter}}" 
                                        Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#xE117;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Checking for updates..." Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- No Update / Up to date (shown when not checking, not downloading, and no update available) -->
                            <TextBlock Text="You're up to date!" FontSize="12"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,8"
                                       Visibility="{Binding IsUpdateAvailable, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            
                            <!-- Check Now Button -->
                            <Button Content="Check for Updates" 
                                    Command="{Binding CheckForUpdatesCommand}"
                                    HorizontalAlignment="Stretch" Padding="10,8" Margin="0,4,0,0"
                                    IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource InverseBoolConverter}}"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <Button x:Name="MinimizeButton" Content="&#xE949;" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize"/>
                <Button x:Name="MaximizeButton" Content="&#xE739;" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click" ToolTip="Maximize"/>
                <Button x:Name="CloseButton" Content="&#xE106;" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>
    </Border>
    
    <!-- Main Content Area -->
    <Grid Grid.Row="1">
<DockPanel>
    <!-- Modern Status Bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource StatusBarBackgroundBrush}" Padding="12,8">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="0,0,8,8"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{DynamicResource StatusBarForegroundBrush}" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding LastRequestUnitsText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" VerticalAlignment="Center" Opacity="0.9" Margin="12,0"
                       Visibility="{Binding LastRequestUnitsText, Converter={StaticResource NullToCollapsedConverter}}"/>
            <TextBlock Grid.Column="2" Text="{Binding LastDurationText}" Foreground="{DynamicResource StatusBarForegroundBrush}" FontSize="12" VerticalAlignment="Center" Opacity="0.9"/>
        </Grid>
    </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPanelColumn" Width="280" MinWidth="200" MaxWidth="500" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel with Collapse Button -->
            <Grid Grid.Column="0" x:Name="LeftPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Collapse/Expand Header -->
                <Border Grid.Row="0" Background="{DynamicResource TertiaryBackgroundBrush}" Padding="8,6">
                    <Grid>
                        <TextBlock Text="Settings" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="CollapseButton" Content="&#xE76B;" 
                                Style="{StaticResource IconButtonStyle}"
                                HorizontalAlignment="Right" Width="28" Height="28"
                                Click="CollapseButton_Click"
                                ToolTip="Collapse panel"/>
                    </Grid>
                </Border>
                
                <ScrollViewer Grid.Row="1" Margin="8" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SecondaryBackgroundBrush}">
                <StackPanel Orientation="Vertical">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Connections" />
                    <ListBox Margin="0,8,0,0" ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}" DisplayMemberPath="Name" Height="140"
                             Background="{DynamicResource TertiaryBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="GuideTarget_NewConnectionButton" Content="New" Command="{Binding NewConnectionCommand}" Style="{StaticResource CompactButtonStyle}" Width="44" />
                        <Button Content="Save" Command="{Binding SaveConnectionCommand}" Style="{StaticResource CompactButtonStyle}" Width="44" Margin="4,0,0,0" />
                        <Button Content="Test" Command="{Binding TestConnectionCommand}" Style="{StaticResource CompactButtonStyle}" Width="44" Margin="4,0,0,0" />
                        <Button Content="Delete" Command="{Binding DeleteConnectionCommand}" Style="{StaticResource CompactButtonStyle}" Width="50" Margin="4,0,0,0" 
                                ToolTip="Delete selected connection"/>
                        <Button Content="Export" Command="{Binding ExportConnectionsCommand}" Style="{StaticResource CompactButtonStyle}" Width="52" Margin="4,0,0,0" />
                        <Button Content="Import" Command="{Binding ImportConnectionsCommand}" Style="{StaticResource CompactButtonStyle}" Width="52" Margin="4,0,0,0" 
                                ToolTip="Import connections from JSON file"/>
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="0,0,8,6" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditConnectionName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                 Background="{DynamicResource TertiaryBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Kind" Margin="0,0,8,6" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ConnectionKinds}" SelectedItem="{Binding EditConnectionKind}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Host" Margin="0,0,8,6" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                 Background="{DynamicResource TertiaryBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Port" Margin="0,0,8,6" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                 Background="{DynamicResource TertiaryBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Username" Margin="0,0,8,6" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EditUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                 Background="{DynamicResource TertiaryBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Secret" Margin="0,0,8,6" />
                        <PasswordBox Grid.Row="5" Grid.Column="1" controls:PasswordBoxHelper.BoundPassword="{Binding EditSecret, Mode=TwoWay}" Margin="0,0,0,6"
                                     Background="{DynamicResource TertiaryBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" />


                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Database" Margin="0,0,8,6" />
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding EditDatabase, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                 Background="{DynamicResource TertiaryBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Graph" Margin="0,0,8,0" />
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding EditGraph, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource TertiaryBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                    </Grid>

                    <Separator Margin="0,14,0,14" Background="{DynamicResource BorderBrush}" />

                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Local Playground" />
                    <Button x:Name="GuideTarget_StartPlaygroundButton" Margin="0,8,0,0" Content="Start" Command="{Binding StartPlaygroundCommand}" />
                    <Button Margin="0,6,0,0" Content="Stop" Command="{Binding StopPlaygroundCommand}" />

                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Scenarios" Margin="0,14,0,0" />
                    <ComboBox Margin="0,8,0,0" ItemsSource="{Binding ScenarioNames}" SelectedItem="{Binding SelectedScenarioName}" />
                    <Button Margin="0,6,0,0" Content="Load" Command="{Binding LoadScenarioCommand}" />
                    <Button Margin="0,6,0,0" Content="Reset" Command="{Binding ResetScenarioCommand}" />

                    <Separator Margin="0,14,0,14" Background="{DynamicResource BorderBrush}" />

                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Execution" />
                    <Button Margin="0,8,0,0" Content="▶ Run (Ctrl+Enter)" Command="{Binding RunQueryCommand}" />
                    <Button Margin="0,6,0,0" Content="■ Cancel (Esc)" Command="{Binding CancelCommand}" />

                    <Separator Margin="0,14,0,14" Background="{DynamicResource BorderBrush}" />

                    <TextBlock x:Name="GuideTarget_SnippetsSection" FontSize="16" FontWeight="SemiBold" Text="Snippets" />
                    <ListBox Margin="0,8,0,0" ItemsSource="{Binding Snippets}" SelectedItem="{Binding SelectedSnippet}" Height="120"
                             Background="{DynamicResource TertiaryBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                             MouseDoubleClick="SnippetList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel ToolTip="{Binding Query}" Margin="0,1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Query}" FontSize="9" FontFamily="Consolas"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                    <TextBlock Text="{Binding Tags}" FontSize="8" FontStyle="Italic"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" Opacity="0.7"
                                               Visibility="{Binding Tags, Converter={StaticResource NullToCollapsedConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Insert" Command="{Binding InsertSnippetCommand}" Style="{StaticResource CompactButtonStyle}" Width="50" ToolTip="Insert selected snippet (or double-click)"/>
                        <Button Content="Del" Command="{Binding DeleteSnippetCommand}" Style="{StaticResource CompactButtonStyle}" Width="36" Margin="4,0,0,0" ToolTip="Delete selected snippet"/>
                    </StackPanel>

                    <Separator Margin="0,14,0,14" Background="{DynamicResource BorderBrush}" />

                    <TextBlock x:Name="GuideTarget_VariablesSection" FontSize="16" FontWeight="SemiBold" Text="Variables" />
                    <TextBlock Text="Use ${name} in queries" FontSize="10" Foreground="{DynamicResource SecondaryForegroundBrush}" FontStyle="Italic" Margin="0,2,0,0"/>
                    <ListBox Margin="0,8,0,0" ItemsSource="{Binding VariableSets}" SelectedItem="{Binding SelectedVariableSet}" DisplayMemberPath="Name" Height="60"
                             Background="{DynamicResource TertiaryBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                    <TextBox Margin="0,6,0,0" Text="{Binding NewVariableSetName, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource TertiaryBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                             Padding="4,4" FontSize="11"/>
                    <TextBox Margin="0,4,0,0" Text="{Binding EditVariableJson, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource TertiaryBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="60" FontFamily="Consolas" FontSize="11"
                             VerticalScrollBarVisibility="Auto"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Save" Command="{Binding SaveVariableSetCommand}" Style="{StaticResource CompactButtonStyle}" Width="44" ToolTip="Save variable set"/>
                        <Button Content="Apply" Command="{Binding ApplyVariablesCommand}" Style="{StaticResource CompactButtonStyle}" Width="48" Margin="4,0,0,0" ToolTip="Substitute variables into query"/>
                        <Button Content="Del" Command="{Binding DeleteVariableSetCommand}" Style="{StaticResource CompactButtonStyle}" Width="36" Margin="4,0,0,0" ToolTip="Delete selected variable set"/>
                    </StackPanel>

                    <Separator Margin="0,14,0,14" Background="{DynamicResource BorderBrush}" />

                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Theme" />
                    <ComboBox x:Name="GuideTarget_ThemeDropdown" Margin="0,8,0,0" ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding SelectedThemeMode}" />
                </StackPanel>
            </ScrollViewer>
            </Grid>
            
            <!-- GridSplitter for resizing - must be direct child of parent Grid -->
            <GridSplitter x:Name="PanelSplitter" Grid.Column="1" Width="5" 
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext"/>
            
            <!-- Expand Button (shown when collapsed) - overlays the splitter area -->
            <Button x:Name="ExpandButton" Grid.Column="1" Content="&#xE76C;" 
                    Style="{StaticResource IconButtonStyle}"
                    Width="28" Height="60" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Click="ExpandButton_Click" Visibility="Collapsed"
                    ToolTip="Expand panel"
                    Background="{DynamicResource TertiaryBackgroundBrush}"/>

            <!-- Query Tabs Area -->
            <Grid Grid.Column="2" Margin="12">
                <!-- Tab Header Strip -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Tab Headers with New Tab Button -->
                <Border Grid.Row="0" Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="6,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding QueryTabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="TabBorder" 
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1,1,1,0"
                                            CornerRadius="6,6,0,0" 
                                            Margin="2,4,0,0" 
                                            Padding="8,6"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="TabHeader_MouseLeftButtonDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.SelectedTab" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1,2,1,0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TabNameText" Text="{Binding TabName}" VerticalAlignment="Center" 
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <Button Content="✕" Width="18" Height="18" Padding="0" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="Transparent" BorderThickness="0" FontSize="10"
                                                    Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                    ToolTip="Close Tab"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="GuideTarget_NewTabButton" Content="+" Command="{Binding NewTabCommand}" 
                                Style="{StaticResource CompactButtonStyle}" 
                                Width="28" Height="28" Margin="4" VerticalAlignment="Bottom"
                                ToolTip="New Query Tab" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Border>
                
                <!-- Tab Content -->
                <Border Grid.Row="1" Background="{DynamicResource PrimaryBackgroundBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ContentControl Content="{Binding SelectedTab}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1*" MinHeight="100" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="2*" MinHeight="150" />
                                    </Grid.RowDefinitions>

                <!-- Query Toolbar -->
                <ToolBar Grid.Row="0" Margin="0,0,0,6" Background="{DynamicResource ToolBarBackgroundBrush}">
                    <Button x:Name="GuideTarget_RunButton" Command="{Binding DataContext.RunQueryCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Execute Query (Ctrl+Enter or F5)" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶" Foreground="#22CC22" FontWeight="Bold" Margin="0,0,6,0"/>
                            <TextBlock Text="Run (Ctrl+Enter)" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Cancel Query (Esc)" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="■" Foreground="#FF4444" FontWeight="Bold" Margin="0,0,6,0"/>
                            <TextBlock Text="Cancel" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                    <Separator />
                    <Button x:Name="GuideTarget_OpenQueryButton" Command="{Binding DataContext.OpenQueryCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Open Query (Ctrl+O)" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Open" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DataContext.SaveQueryCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Save Query (Ctrl+S)" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Save" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                    <Separator />
                    <Button x:Name="GuideTarget_FormatButton" Command="{Binding DataContext.FormatQueryCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Format Query (Ctrl+Shift+F)" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Format" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="GuideTarget_ResolveButton" Command="{Binding DataContext.ResolveParametersCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Resolve parameterized query from ORM log (Ctrl+P)" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"
                                       Foreground="#C586C0"/>
                            <TextBlock Text="Resolve" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DataContext.SaveAsSnippetCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Save current query as snippet" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"
                                       Foreground="#4EC9B0"/>
                            <TextBlock Text="Snippet" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DataContext.ExplainQueryCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Explain Query (Ctrl+E)" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"
                                       Foreground="#DCDCAA"/>
                            <TextBlock Text="Explain" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                    <Separator />

                    <!-- Query History Dropdown -->
                    <TextBlock x:Name="GuideTarget_HistoryDropdown" Text="History:" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <ComboBox Width="350" 
                              ItemsSource="{Binding DataContext.QueryHistory, RelativeSource={RelativeSource AncestorType=Window}}" 
                              SelectedItem="{Binding DataContext.SelectedHistoryItem, RelativeSource={RelativeSource AncestorType=Window}}"
                              IsSynchronizedWithCurrentItem="False"
                              ToolTip="Select a previous query from history">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MaxWidth="420">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📌" Margin="0,0,4,0" FontSize="10"
                                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Query}" TextTrimming="CharacterEllipsis" 
                                               FontFamily="Consolas" FontSize="11" ToolTip="{Binding Query}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Padding="3,1" Margin="4,0,0,0" VerticalAlignment="Center"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding DataContext.TogglePinQueryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Unpin/Pin}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="ToolTip" Value="Pin query"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter Property="ToolTip" Value="Unpin query"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="📍"/>
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Text" Value="📌"/>
                                                            <Setter Property="Opacity" Value="1.0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <Button Grid.Column="3" Padding="3,1" Margin="2,0,0,0" VerticalAlignment="Center"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding DataContext.RemoveFromHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Remove from history">
                                        <TextBlock Text="✕" FontSize="10" Foreground="#FF6B6B" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Command="{Binding DataContext.ClearQueryHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                            ToolTip="Clear unpinned history" Padding="6,4">
                        <TextBlock Text="✕" FontSize="12" Foreground="#FF6B6B" FontWeight="Bold"/>
                    </Button>

                    <Separator />
                    <TextBlock Text="Connection:" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding ConnectionDisplayName}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <Separator/>
                    <TextBlock Text="{Binding LastResultCountText}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0"
                               Foreground="{DynamicResource AccentBrush}"
                               Visibility="{Binding LastResultCountText, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <Separator Visibility="{Binding LastResultCountText, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <TextBlock Text="Status:" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0" 
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                </ToolBar>

                <!-- Query Editor -->
                <GroupBox Header="Query (Tab for autocomplete)" Grid.Row="1" Margin="0,0,0,6" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}">
                    <avalonedit:TextEditor
                        x:Name="QueryEditor"
                        FontFamily="Consolas"
                        FontSize="{Binding EditorFontSize}"
                        ShowLineNumbers="True"
                        Background="{DynamicResource EditorBackgroundBrush}"
                        Foreground="{DynamicResource EditorForegroundBrush}"
                        controls:TextEditorHelper.BoundText="{Binding QueryText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        controls:TextEditorHelper.EnableGremlinFeatures="True"
                        PreviewMouseWheel="QueryEditor_PreviewMouseWheel" />
                </GroupBox>

                <!-- Results Splitter -->
                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" 
                              Background="Transparent" Cursor="SizeNS"/>


                <!-- Results with Multiple Views -->
                <GroupBox Header="Results" Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}">
                    <TabControl SelectedIndex="{Binding SelectedResultViewIndex}" Background="{DynamicResource SecondaryBackgroundBrush}">
                        <!-- Raw JSON View with Syntax Highlighting -->
                        <TabItem x:Name="GuideTarget_JsonTab" Header="JSON">
                            <DockPanel>
                                <ToolBar DockPanel.Dock="Top" Background="{DynamicResource ToolBarBackgroundBrush}">
                                    <Button Command="{Binding CopyJsonToClipboardCommand}" 
                                            ToolTip="Copy JSON to clipboard" Padding="8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" 
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="Copy All" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </ToolBar>
                                <avalonedit:TextEditor
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    IsReadOnly="True"
                                    ShowLineNumbers="True"
                                    Background="{DynamicResource EditorBackgroundBrush}"
                                    Foreground="{DynamicResource EditorForegroundBrush}"
                                    controls:TextEditorHelper.BoundText="{Binding ResultJson, Mode=OneWay}"
                                    controls:TextEditorHelper.SyntaxMode="Json"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Auto" />
                            </DockPanel>
                        </TabItem>
                        
                        <!-- Table/List View -->
                        <TabItem x:Name="GuideTarget_TableTab" Header="Table">
                            <DockPanel>
                                <ToolBar DockPanel.Dock="Top" Background="{DynamicResource ToolBarBackgroundBrush}">
                                    <Button Command="{Binding ExportTableToCsvCommand}" 
                                            ToolTip="Export table data to CSV file" Padding="8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⬇" FontSize="12" Margin="0,0,6,0" Foreground="#4EC9B0" FontWeight="Bold"/>
                                            <TextBlock Text="Export to CSV" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ExportTableToXlsxCommand}" 
                                            ToolTip="Export table data to Excel file" Padding="8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⬇" FontSize="12" Margin="0,0,6,0" Foreground="#569CD6" FontWeight="Bold"/>
                                            <TextBlock Text="Export to Excel" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Separator/>
                                    <CheckBox IsChecked="{Binding ConvertEpochDates}"
                                              ToolTip="Convert columns with date/time-like names from epoch values to Excel dates"
                                              VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="Convert epoch dates" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </CheckBox>
                                    <Separator Visibility="{Binding IsEditingRow, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Command="{Binding SaveEditedRowCommand}" 
                                            ToolTip="Save changes to the edited row" Padding="8,4"
                                            Visibility="{Binding IsEditingRow, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" Foreground="#22CC22"/>
                                            <TextBlock Text="Save Row" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding CancelEditRowCommand}" 
                                            ToolTip="Cancel editing and restore original values" Padding="8,4"
                                            Visibility="{Binding IsEditingRow, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" Foreground="#FF4444"/>
                                            <TextBlock Text="Cancel Edit" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </ToolBar>
                                <DataGrid 
                                    x:Name="ResultDataGrid"
                                    ItemsSource="{Binding ResultTable}"
                                    AutoGenerateColumns="True"
                                    AutoGeneratingColumn="ResultDataGrid_AutoGeneratingColumn"
                                    ColumnReordered="ResultDataGrid_ColumnReordered"
                                    BeginningEdit="ResultDataGrid_BeginningEdit"
                                    IsReadOnly="True"
                                    CanUserAddRows="False"
                                    CanUserDeleteRows="False"
                                    GridLinesVisibility="All"
                                    SelectionUnit="CellOrRowHeader"
                                    ClipboardCopyMode="ExcludeHeader"
                                    RowBackground="{DynamicResource PrimaryBackgroundBrush}"
                                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                                    AlternatingRowBackground="{DynamicResource SecondaryBackgroundBrush}"
                                    Background="{DynamicResource EditorBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                    VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                                    ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy Cell" Click="CopyCell_Click" InputGestureText="Ctrl+C"/>
                                            <MenuItem Header="Copy Row" Click="CopyRow_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Edit Row" Click="EditRow_Click" InputGestureText="F2"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        
                        <!-- Tree View / Schema Explorer -->
                        <TabItem x:Name="GuideTarget_TreeTab" Header="Tree">
                            <DockPanel>
                                <!-- Schema Explorer Toolbar -->
                                <ToolBar DockPanel.Dock="Top" Background="{DynamicResource ToolBarBackgroundBrush}">
                                    <!-- Mode Toggle Buttons -->
                                    <RadioButton Content="📊 Data" 
                                                 IsChecked="{Binding IsSchemaExplorerMode, Converter={StaticResource InverseBoolConverter}}"
                                                 GroupName="TreeViewMode" 
                                                 Padding="8,4" Margin="2,0"
                                                 ToolTip="View query result data"
                                                 Style="{StaticResource {x:Type ToggleButton}}"/>
                                    <RadioButton Content="🔍 Schema" 
                                                 IsChecked="{Binding IsSchemaExplorerMode}"
                                                 GroupName="TreeViewMode" 
                                                 Padding="8,4" Margin="2,0"
                                                 ToolTip="View graph schema (auto-discovers on first click)"
                                                 Style="{StaticResource {x:Type ToggleButton}}"/>
                                    
                                    <!-- Cancel button (shown during discovery) -->
                                    <Button Command="{Binding CancelSchemaDiscoveryCommand}" 
                                            ToolTip="Cancel schema discovery" Padding="6,4"
                                            Visibility="{Binding IsDiscoveringSchema, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="■" Foreground="#FF4444" FontWeight="Bold"/>
                                    </Button>
                                    
                                    <!-- Progress indicator -->
                                    <Border Width="100" Height="6" Margin="8,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsDiscoveringSchema, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="3">
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="3"
                                                HorizontalAlignment="Left"
                                                Width="{Binding SchemaProgressPercent, Converter={StaticResource ProgressToWidthConverter}, ConverterParameter=100}"/>
                                    </Border>
                                    
                                    <Separator Visibility="{Binding HasDiscoveredSchema, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    
                                    <!-- Schema Export (only when schema is discovered) -->
                                    <Button Command="{Binding ExportSchemaToCodeCommand}" 
                                            ToolTip="Generate Stardust.Paradox interfaces" Padding="8,4"
                                            Visibility="{Binding HasDiscoveredSchema, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Generate Code" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding CopySchemaToClipboardCommand}" 
                                            ToolTip="Copy generated code to clipboard" Padding="6,4"
                                            Visibility="{Binding HasDiscoveredSchema, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="📋" FontSize="12"/>
                                    </Button>
                                    <Button Command="{Binding SaveSchemaToFileCommand}" 
                                            ToolTip="Save generated code to file" Padding="6,4"
                                            Visibility="{Binding HasDiscoveredSchema, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="💾" FontSize="12"/>
                                    </Button>
                                </ToolBar>
                                
                                <!-- Discovery Status Bar (shown during discovery) -->
                                <Border DockPanel.Dock="Top" Background="{DynamicResource TertiaryBackgroundBrush}" 
                                        Padding="8,4"
                                        Visibility="{Binding IsDiscoveringSchema, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SchemaDiscoveryStatus}" FontSize="11" 
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </Border>
                                
                                <!-- Main Content Grid - switches between data and schema views -->
                                <Grid>
                                    <!-- Data Tree View (when not in schema mode) -->
                                    <TreeView ItemsSource="{Binding ResultTreeItems}" 
                                              Background="{DynamicResource EditorBackgroundBrush}" 
                                              Foreground="{DynamicResource EditorForegroundBrush}"
                                              FontFamily="Consolas"
                                              FontSize="12"
                                              BorderBrush="{DynamicResource BorderBrush}"
                                              Visibility="{Binding IsSchemaExplorerMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem">
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <Grid x:Name="NodeGrid">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="20"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}" Foreground="#569CD6" Margin="0,0,6,0" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="{Binding FontWeight}" Foreground="{DynamicResource EditorForegroundBrush}"/>
                                                        <TextBlock Text=": " Visibility="{Binding Value, Converter={StaticResource NullToCollapsedConverter}}" Foreground="{DynamicResource EditorForegroundBrush}"/>
                                                        <TextBlock Text="{Binding Value}" Foreground="#CE9178"/>
                                                    </StackPanel>
                                                    <!-- Expand/Collapse All Button - fixed width column prevents layout shift -->
                                                    <Button x:Name="ExpandCollapseButton"
                                                            Grid.Column="1"
                                                            Content="{Binding ExpandCollapseIcon}"
                                                            ToolTip="{Binding ExpandCollapseTooltip}"
                                                            Click="TreeViewExpandCollapseButton_Click"
                                                            Visibility="Hidden"
                                                            Width="14" Height="14"
                                                            Margin="4,0,0,0"
                                                            Padding="0"
                                                            FontWeight="Bold"
                                                            FontSize="10"
                                                            VerticalContentAlignment="Center"
                                                            HorizontalContentAlignment="Center"
                                                            Background="#0078D4"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"/>
                                                </Grid>
                                                <HierarchicalDataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                                        <Setter TargetName="ExpandCollapseButton" Property="Visibility" Value="Hidden"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasChildren}" Value="True"/>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="ExpandCollapseButton" Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </HierarchicalDataTemplate.Triggers>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                    
                                    <!-- Schema Tree View (when in schema mode) -->
                                    <Grid Visibility="{Binding IsSchemaExplorerMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="200"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Schema Tree -->
                                        <TreeView Grid.Row="0" ItemsSource="{Binding SchemaTreeItems}" 
                                                  Background="{DynamicResource EditorBackgroundBrush}" 
                                                  Foreground="{DynamicResource EditorForegroundBrush}"
                                                  FontFamily="Consolas"
                                                  FontSize="12"
                                                  BorderBrush="{DynamicResource BorderBrush}">
                                            <TreeView.ItemContainerStyle>
                                                <Style TargetType="TreeViewItem">
                                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                                </Style>
                                            </TreeView.ItemContainerStyle>
                                            <TreeView.ItemTemplate>
                                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}" Foreground="#569CD6" Margin="0,0,6,0" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="{Binding FontWeight}" Foreground="{DynamicResource EditorForegroundBrush}"/>
                                                        <TextBlock Text=" " Visibility="{Binding Value, Converter={StaticResource NullToCollapsedConverter}}"/>
                                                        <TextBlock Text="{Binding Value}" Foreground="#CE9178"/>
                                                    </StackPanel>
                                                </HierarchicalDataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                        
                                        
                                        <!-- Code Preview Splitter -->
                                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" 
                                                      Background="Transparent" Cursor="SizeNS"
                                                      Visibility="{Binding HasDiscoveredSchema, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        
                                        <!-- Generated Code Preview -->
                                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                                Visibility="{Binding HasDiscoveredSchema, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Top" Background="{DynamicResource TertiaryBackgroundBrush}" Padding="8,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Namespace:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBox Grid.Column="1" Text="{Binding SchemaExportNamespace, UpdateSourceTrigger=PropertyChanged}" 
                                                                 Width="200" Padding="4,2"
                                                                 Background="{DynamicResource EditorBackgroundBrush}"
                                                                 Foreground="{DynamicResource EditorForegroundBrush}"
                                                                 BorderBrush="{DynamicResource BorderBrush}"/>
                                                        <TextBlock Grid.Column="3" Text="Context:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                                                        <TextBox Grid.Column="4" Text="{Binding SchemaContextClassName, UpdateSourceTrigger=PropertyChanged}" 
                                                                 Width="140" Padding="4,2"
                                                                 Background="{DynamicResource EditorBackgroundBrush}"
                                                                 Foreground="{DynamicResource EditorForegroundBrush}"
                                                                 BorderBrush="{DynamicResource BorderBrush}"/>
                                                    </Grid>
                                                </Border>
                                                <avalonedit:TextEditor
                                                    FontFamily="Consolas"
                                                    FontSize="11"
                                                    IsReadOnly="True"
                                                    ShowLineNumbers="True"
                                                    Background="{DynamicResource EditorBackgroundBrush}"
                                                    Foreground="{DynamicResource EditorForegroundBrush}"
                                                    controls:TextEditorHelper.BoundText="{Binding SchemaCodePreview}"
                                                    controls:TextEditorHelper.SyntaxMode="CSharp"
                                                    VerticalScrollBarVisibility="Auto"
                                                    HorizontalScrollBarVisibility="Auto"/>
                                            </DockPanel>
                                        </Border>
                                        
                                        <!-- Empty state when no schema -->
                                        <Border Grid.Row="0" Grid.RowSpan="3" 
                                                Background="{DynamicResource EditorBackgroundBrush}"
                                                Visibility="{Binding HasDiscoveredSchema, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                                <TextBlock Text="No schema available" FontSize="16" FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Run a query that returns vertices/edges, then click Schema" FontSize="12" 
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    
                                    <!-- Schema Discovery Progress Overlay - overlays entire tree area -->
                                    <Border Visibility="{Binding IsDiscoveringSchema, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="#E0000000">
                                        <Grid>
                                            <!-- Background Image (analyzer.png) -->
                                            <Image Source="/Resources/analyzer.png" 
                                                   Stretch="Uniform" 
                                                   Opacity="0.3"
                                                   MaxWidth="200"
                                                   MaxHeight="200"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                            
                                            <!-- Progress Content -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <!-- Progress Bar -->
                                                <Grid Width="200" Height="8" Margin="0,0,0,16">
                                                    <Border Background="#333333" CornerRadius="4"/>
                                                    <Border Background="{DynamicResource AccentBrush}" 
                                                            CornerRadius="4"
                                                            HorizontalAlignment="Left"
                                                            Width="{Binding SchemaProgressPercent, Converter={StaticResource ProgressToWidthConverter}, ConverterParameter=200}"/>
                                                </Grid>
                                                
                                                <TextBlock Text="Discovering Schema" 
                                                           FontSize="18" 
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,8"/>
                                                
                                                <TextBlock Text="{Binding SchemaDiscoveryStatus}" 
                                                           FontSize="12" 
                                                           Foreground="#CCCCCC"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="280"/>
                                                
                                                <TextBlock Text="{Binding SchemaProgressPercent, StringFormat={}{0}%}" 
                                                           FontSize="11" 
                                                           Foreground="#888888"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,4,0,0"/>
                                                
                                                <Button Content="Cancel" 
                                                        Command="{Binding CancelSchemaDiscoveryCommand}"
                                                        Padding="16,6"
                                                        Margin="0,16,0,0"
                                                        HorizontalAlignment="Center"
                                                        Background="#DD4444"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                        
                        
                        
                        
                        <!-- Graph View - Azure Portal Style -->
                        <TabItem x:Name="GuideTarget_GraphTab" Header="Graph">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Results List (Left Panel) - shows all query results -->
                                <Border Grid.Column="0" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                                            <TextBlock Text="Results" FontWeight="SemiBold"/>
                                            <TextBlock Text="Click to view connections" FontSize="10" Foreground="Gray" FontStyle="Italic"/>
                                        </StackPanel>
                                        <ListBox ItemsSource="{Binding ResultNodes}" 
                                                 SelectedItem="{Binding SelectedResultNode}"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                 BorderThickness="0"
                                                 Margin="4,0,4,4">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="2">
                                                        <Ellipse Width="12" Height="12" Fill="{Binding Fill}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding ShortId}" FontFamily="Consolas" FontSize="11" 
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                                
                                <!-- Graph Visualization (Center Panel) -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Toolbar -->
                                    <ToolBar Grid.Row="0" Background="{DynamicResource ToolBarBackgroundBrush}">
                                        <TextBlock Text="Graph" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,12,0"/>
                                        <Separator/>
                                        <Button Content="+" Command="{Binding ZoomInCommand}" ToolTip="Zoom In (Ctrl+Scroll Up)" Width="28" FontWeight="Bold"/>
                                        <Button Content="-" Command="{Binding ZoomOutCommand}" ToolTip="Zoom Out (Ctrl+Scroll Down)" Width="28" FontWeight="Bold"/>
                                        <Button Content="Reset" Command="{Binding ResetGraphCommand}" Padding="8,2" ToolTip="Reset zoom and pan"/>
                                    </ToolBar>
                                    
                                    <!-- Graph Canvas with Zoom and Pan -->
                                    <Border x:Name="GraphCanvasBorder" Grid.Row="1" 
                                            Background="#2D2D30" ClipToBounds="True"
                                            MouseDown="GraphCanvas_MouseDown" MouseMove="GraphCanvas_MouseMove" 
                                            MouseUp="GraphCanvas_MouseUp" MouseLeave="GraphCanvas_MouseLeave"
                                            MouseWheel="GraphCanvas_MouseWheel">
                                        <Canvas x:Name="GraphCanvas">
                                            <Canvas.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="{Binding GraphZoom}" ScaleY="{Binding GraphZoom}"/>
                                                    <TranslateTransform X="{Binding GraphPanX, Mode=TwoWay}" Y="{Binding GraphPanY, Mode=TwoWay}"/>
                                                </TransformGroup>
                                            </Canvas.RenderTransform>
                                            
                                            <!-- Edges - rendered as curved lines with arrows -->
                                            <ItemsControl ItemsSource="{Binding GraphEdges}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas IsItemsHost="True"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <Canvas>
                                                                        <!-- Edge line (stroke only, no fill) -->
                                                                        <Path Stroke="{Binding IsSelected, Converter={StaticResource BoolToEdgeColorConverter}}" 
                                                                              StrokeThickness="{Binding IsSelected, Converter={StaticResource BoolToEdgeThicknessConverter}}" 
                                                                              Data="{Binding CurvePathData}" Cursor="Hand">
                                                                            <Path.InputBindings>
                                                                                <MouseBinding MouseAction="LeftClick" 
                                                                                              Command="{Binding DataContext.SelectGraphEdgeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                              CommandParameter="{Binding}"/>
                                                                            </Path.InputBindings>
                                                                        </Path>
                                                                        <!-- Arrow head (fill only) -->
                                                                        <Path Fill="{Binding IsSelected, Converter={StaticResource BoolToEdgeColorConverter}}" 
                                                                              Data="{Binding ArrowPathData}"/>
                                                                    </Canvas>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                            </ItemsControl>
                                            
                                            
                                            
                                            
                                            <!-- Edge labels - separate layer, clickable to select edge -->
                                            <ItemsControl ItemsSource="{Binding GraphEdges}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas IsItemsHost="True"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding LabelX}"/>
                                                        <Setter Property="Canvas.Top" Value="{Binding LabelY}"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding IsSelected, Converter={StaticResource BoolToLabelBackgroundConverter}}" 
                                                                CornerRadius="3" Padding="4,2" Cursor="Hand">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" 
                                                                              Command="{Binding DataContext.SelectGraphEdgeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>
                                                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#EEEEEE"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            
                                            <!-- Nodes -->
                                            <ItemsControl ItemsSource="{Binding GraphNodes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="-25,-25,0,0" Cursor="SizeAll"
                                                              MouseLeftButtonDown="GraphNode_MouseLeftButtonDown">
                                                            <!-- Drop shadow effect -->
                                                            <Ellipse Width="52" Height="52" Fill="#50000000" Margin="3,3,0,0"/>
                                                            <!-- Selection ring -->
                                                            <Ellipse Width="58" Height="58" Margin="-4,-4,0,0"
                                                                     Stroke="#00AAFF" StrokeThickness="3"
                                                                     Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <!-- Node circle -->
                                                            <Ellipse Width="50" Height="50" 
                                                                     Fill="{Binding Fill}" 
                                                                     Stroke="#555555" StrokeThickness="2"/>
                                                            <!-- Node label -->
                                                            <TextBlock Text="{Binding Label}" 
                                                                       Foreground="White" FontWeight="Bold" FontSize="10"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="44">
                                                                <TextBlock.Effect>
                                                                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Color="Black" Opacity="0.8"/>
                                                                </TextBlock.Effect>
                                                            </TextBlock>
                                                            <!-- ID below node with background -->
                                                            <Border Background="#CC2D2D30" CornerRadius="3" Padding="5,2" 
                                                                    HorizontalAlignment="Center" Margin="0,56,0,0">
                                                                <TextBlock Text="{Binding ShortId}" 
                                                                           Foreground="#EEEEEE" 
                                                                           FontSize="9" FontFamily="Consolas"/>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            
                                            <!-- Placeholder message when no graph data -->
                                            <TextBlock Text="Select a result to view connections"
                                                       Visibility="{Binding HasGraphData, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                       Foreground="#888888" FontStyle="Italic"
                                                       Canvas.Left="100" Canvas.Top="100"/>
                                        </Canvas>
                                    </Border>
                                </Grid>
                                
                                <!-- Properties Panel (Right) - Azure Portal Style -->
                                <Border Grid.Column="2" Background="{DynamicResource TertiaryBackgroundBrush}" 
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="12,8">
                                            <!-- Element Title -->
                                            <TextBlock Text="{Binding SelectedElementTitle}" FontSize="14" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                                            
                                            <!-- No Selection Message -->
                                            <TextBlock Text="Select a vertex or edge to view properties"
                                                       Visibility="{Binding HasSelectedElement, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontStyle="Italic" TextWrapping="Wrap"/>
                                            
                                            <!-- Properties Section -->
                                            <StackPanel Visibility="{Binding HasSelectedElement, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Properties" FontWeight="SemiBold" Foreground="#0078D4" Margin="0,0,0,8"/>
                                                <ItemsControl ItemsSource="{Binding SelectedElementProperties}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="80"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Key}" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="11"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                
                                                <!-- Sources Section (for vertices) -->
                                                <TextBlock Text="Sources" FontWeight="SemiBold" Foreground="#0078D4" Margin="0,16,0,8"
                                                           Visibility="{Binding HasIncomingEdges, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <ItemsControl ItemsSource="{Binding IncomingEdges}"
                                                              Visibility="{Binding HasIncomingEdges, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4" Cursor="Hand">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding SourceId}" Foreground="#0078D4" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11" 
                                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="8,0,0,0"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                
                                                <!-- Targets Section (for vertices) -->
                                                <TextBlock Text="Targets" FontWeight="SemiBold" Foreground="#0078D4" Margin="0,16,0,8"
                                                           Visibility="{Binding HasOutgoingEdges, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <ItemsControl ItemsSource="{Binding OutgoingEdges}"
                                                              Visibility="{Binding HasOutgoingEdges, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4" Cursor="Hand">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding TargetId}" Foreground="#0078D4" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11" 
                                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="8,0,0,0"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>
                        
                        <!-- Scenario Export Tab -->
                        <TabItem x:Name="GuideTarget_ExportTab" Header="Export">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Export Settings Panel -->
                                <Border Grid.Column="0" Background="{DynamicResource TertiaryBackgroundBrush}" 
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="12,8">
                                            <TextBlock Text="Export Settings" FontSize="14" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,0,12"/>
                                            
                                            <TextBlock Text="Scenario Name:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding ExportScenarioName, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{DynamicResource EditorBackgroundBrush}"
                                                     Foreground="{DynamicResource EditorForegroundBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>
                                            
                                            <TextBlock Text="Description:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding ExportScenarioDescription, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{DynamicResource EditorBackgroundBrush}"
                                                     Foreground="{DynamicResource EditorForegroundBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}"
                                                     TextWrapping="Wrap" AcceptsReturn="True" Height="60" Margin="0,0,0,12"/>
                                            
                                            <TextBlock Text="Export Format:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding ExportFormats}" 
                                                      SelectedItem="{Binding SelectedExportFormat, Mode=TwoWay}"
                                                      Margin="0,0,0,12"/>
                                            
                                            <TextBlock Text="Namespace (C# only):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding ExportNamespace, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{DynamicResource EditorBackgroundBrush}"
                                                     Foreground="{DynamicResource EditorForegroundBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}" 
                                                     Margin="0,0,0,12"
                                                     ToolTip="The namespace for the generated C# class"/>
                                            
                                            <Separator Margin="0,4,0,16" Background="{DynamicResource BorderBrush}"/>
                                            
                                            <Button Content="🔄 Generate Preview" 
                                                    Command="{Binding GenerateExportPreviewCommand}" 
                                                    IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBoolConverter}}"
                                                    Padding="8,6" Margin="0,0,0,8"/>
                                            
                                            <Button Content="💾 Save to File..." 
                                                    Command="{Binding SaveScenarioExportCommand}"
                                                    IsEnabled="{Binding HasExportData}"
                                                    Padding="8,6" Margin="0,0,0,12"/>
                                            
                                            <Separator Margin="0,4,0,16" Background="{DynamicResource BorderBrush}"/>
                                            
                                            <TextBlock Text="Agent Skills" FontSize="14" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,0,8"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                Download reusable InMemory scenario skills from the Stardust.Paradox repository for use with AI agent frameworks.
                                            </TextBlock>
                                            
                                            <Button Content="📥 Download Agent Skills..." 
                                                    Command="{Binding DataContext.DownloadAgentSkillsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    IsEnabled="{Binding IsDownloadingSkills, Converter={StaticResource InverseBoolConverter}}"
                                                    Padding="8,6" Margin="0,0,0,8"/>
                                            
                                            <!-- Skills download progress -->
                                            <TextBlock Text="{Binding SkillsDownloadStatusText}" FontSize="11" 
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       TextWrapping="Wrap" Margin="0,0,0,12"
                                                       Visibility="{Binding SkillsDownloadStatusText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                            
                                            <Border Background="{DynamicResource SecondaryBackgroundBrush}" 
                                                    CornerRadius="4" Padding="8" Margin="0,0,0,12"
                                                    Visibility="{Binding IsDownloadingSkills, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel>
                                                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"/>
                                                    <TextBlock Text="{Binding SkillsDownloadStatusText}" FontSize="11"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            
                                            <!-- Progress Indicator -->
                                            <Border Background="{DynamicResource SecondaryBackgroundBrush}" 
                                                    CornerRadius="4" Padding="8" Margin="0,0,0,12"
                                                    Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel>
                                                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"/>
                                                    <TextBlock Text="{Binding ExportStatusText}" FontSize="11" 
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            
                                            <!-- Status when not exporting -->
                                            <TextBlock Text="{Binding ExportStatusText}" FontSize="11" 
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       TextWrapping="Wrap" Margin="0,0,0,12"
                                                       Visibility="{Binding IsExporting, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                            
                                            <Separator Margin="0,4,0,16" Background="{DynamicResource BorderBrush}"/>
                                            
                                            <TextBlock Text="Instructions" FontWeight="SemiBold" Foreground="#0078D4" Margin="0,0,0,8"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                <Run>1. Run a query that returns vertices/edges</Run>
                                                <LineBreak/>
                                                <Run>2. Enter a scenario name</Run>
                                                <LineBreak/>
                                                <Run>3. Choose format (JSON or C#)</Run>
                                                <LineBreak/>
                                                <Run>4. Click Generate Preview</Run>
                                                <LineBreak/>
                                                <Run>5. Save to file</Run>
                                            </TextBlock>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                                
                                <!-- Export Preview Panel -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Border Grid.Row="0" Background="{DynamicResource TertiaryBackgroundBrush}" Padding="8,6">
                                        <TextBlock Text="Preview" FontWeight="SemiBold"/>
                                    </Border>
                                    
                                    <!-- Preview with Syntax Highlighting -->
                                    <avalonedit:TextEditor Grid.Row="1"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             IsReadOnly="True"
                                             ShowLineNumbers="True"
                                             Background="{DynamicResource EditorBackgroundBrush}"
                                             Foreground="{DynamicResource EditorForegroundBrush}"
                                             controls:TextEditorHelper.BoundText="{Binding ExportPreview}"
                                             controls:TextEditorHelper.SyntaxMode="{Binding SelectedExportFormat, Converter={StaticResource ExportFormatToSyntaxModeConverter}, Mode=OneWay}"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"/>
                                    
                                    <!-- Progress Overlay -->
                                    <Border Grid.Row="1" 
                                            Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="#E0000000">
                                        <Grid>
                                            <!-- Background Image -->
                                            <Image Source="/Resources/progress.png" 
                                                   Stretch="Uniform" 
                                                   Opacity="0.3"
                                                   MaxWidth="300"
                                                   MaxHeight="300"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                            
                                            <!-- Progress Content -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <ProgressBar IsIndeterminate="True" 
                                                             Height="6" Width="200" 
                                                             Margin="0,0,0,16"/>
                                                
                                                <TextBlock Text="{Binding ExportStepName}" 
                                                           FontSize="18" 
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,8"/>
                                                
                                                <TextBlock Text="{Binding ExportStatusText}" 
                                                           FontSize="12" 
                                                           Foreground="#CCCCCC"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="280"/>
                                                
                                                <Button Content="Cancel" 
                                                        Command="{Binding CancelExportCommand}"
                                                        Padding="16,6"
                                                        Margin="0,16,0,0"
                                                        HorizontalAlignment="Center"
                                                        Background="#DD4444"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                        
                        <!-- Execution Log Tab -->
                        <TabItem x:Name="GuideTarget_LogTab" Header="Log">
                            <DockPanel>
                                <ToolBar DockPanel.Dock="Top" Background="{DynamicResource ToolBarBackgroundBrush}">
                                    <Button Command="{Binding ClearExecutionLogCommand}" 
                                            ToolTip="Clear execution log" Padding="8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" 
                                                       Foreground="#FF6B6B"/>
                                            <TextBlock Text="Clear Log" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Separator/>
                                    <TextBlock Text="{Binding ExecutionLog.Count, StringFormat='{}{0} entries'}" 
                                               VerticalAlignment="Center" Margin="4,0"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"/>
                                </ToolBar>
                                <DataGrid ItemsSource="{Binding ExecutionLog}"
                                          SelectedItem="{Binding SelectedLogEntry}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          GridLinesVisibility="Horizontal"
                                          SelectionUnit="FullRow"
                                          SelectionMode="Single"
                                          RowBackground="{DynamicResource PrimaryBackgroundBrush}"
                                          Foreground="{DynamicResource PrimaryForegroundBrush}"
                                          AlternatingRowBackground="{DynamicResource SecondaryBackgroundBrush}"
                                          Background="{DynamicResource EditorBackgroundBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                          FontFamily="Consolas"
                                          FontSize="11"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="24" CanUserResize="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Ellipse Width="10" Height="10" 
                                                             Fill="{Binding IsSuccess, Converter={StaticResource BoolToStatusColorConverter}}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="70"/>
                                        <DataGridTextColumn Header="Query" Binding="{Binding Query}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    <Setter Property="ToolTip" Value="{Binding Query}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration.TotalMilliseconds, StringFormat='{}{0:F0}ms'}" Width="75"/>
                                        <DataGridTextColumn Header="Results" Binding="{Binding ResultCount}" Width="60"/>
                                        <DataGridTextColumn Header="RU" Binding="{Binding RequestUnits, StringFormat='{}{0:F2}'}" Width="65"/>
                                        <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="200">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FF6B6B"/>
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        
                        <!-- Query Explain Tab -->
                        <TabItem x:Name="GuideTarget_ExplainTab" Header="Explain">
                            <DockPanel>
                                <ToolBar DockPanel.Dock="Top" Background="{DynamicResource ToolBarBackgroundBrush}">
                                    <Button Command="{Binding DataContext.ExplainQueryCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                            ToolTip="Explain current query (Ctrl+E)" Padding="8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" 
                                                       Foreground="#DCDCAA"/>
                                            <TextBlock Text="Explain Query" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Separator/>
                                    <Button Command="{Binding CopyExplanationToClipboardCommand}" 
                                            ToolTip="Copy explanation to clipboard" Padding="8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" 
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="Copy" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </ToolBar>
                                <avalonedit:TextEditor
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    IsReadOnly="True"
                                    ShowLineNumbers="False"
                                    Background="{DynamicResource EditorBackgroundBrush}"
                                    Foreground="{DynamicResource EditorForegroundBrush}"
                                    controls:TextEditorHelper.BoundText="{Binding QueryExplanation, Mode=OneWay}"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Auto"
                                    WordWrap="True"/>
                            </DockPanel>
                        </TabItem>
                        
                        <!-- Database Statistics Tab -->
                        <TabItem x:Name="GuideTarget_StatsTab" Header="Stats">
                            <DockPanel>
                                <ToolBar DockPanel.Dock="Top" Background="{DynamicResource ToolBarBackgroundBrush}">
                                    <Button Command="{Binding DataContext.LoadDatabaseStatisticsCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                            ToolTip="Refresh database statistics" Padding="8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" 
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="Refresh" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Separator/>
                                    <TextBlock Text="{Binding StatisticsStatusText}" VerticalAlignment="Center" Margin="4,0"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"/>
                                </ToolBar>
                                
                                <!-- Loading Indicator -->
                                <Border DockPanel.Dock="Top" Padding="8,6"
                                        Visibility="{Binding IsLoadingStatistics, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ProgressBar IsIndeterminate="True" Height="4" Width="120" Margin="0,0,8,0"/>
                                        <TextBlock Text="Loading statistics..." FontSize="12" 
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </StackPanel>
                                </Border>
                                
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource EditorBackgroundBrush}">
                                    <Grid>
                                        <!-- Empty state: no statistics loaded yet -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Visibility="{Binding HasStatistics, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                            <TextBlock Text="No statistics loaded" FontSize="16" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Click Refresh to load database statistics" FontSize="12" 
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding StatisticsStatusText}" FontSize="12" Margin="0,12,0,0"
                                                       Foreground="#FF6B6B" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"
                                                       Visibility="{Binding StatisticsStatusText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                        </StackPanel>
                                    
                                        <!-- Has Statistics -->
                                        <StackPanel Margin="16" Visibility="{Binding HasStatistics, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <!-- Summary Cards -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="8" Padding="16">
                                                <StackPanel>
                                                    <TextBlock Text="Total Vertices" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <TextBlock Text="{Binding TotalVertexCount, StringFormat=N0}" FontSize="28" FontWeight="Bold" 
                                                               Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{DynamicResource TertiaryBackgroundBrush}" CornerRadius="8" Padding="16">
                                                <StackPanel>
                                                    <TextBlock Text="Total Edges" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <TextBlock Text="{Binding TotalEdgeCount, StringFormat=N0}" FontSize="28" FontWeight="Bold" 
                                                               Foreground="#4EC9B0" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        
                                        <!-- Vertex Labels -->
                                        <TextBlock Text="Vertex Labels" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,0,8"/>
                                        <DataGrid ItemsSource="{Binding VertexLabelCounts}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  GridLinesVisibility="Horizontal"
                                                  RowBackground="{DynamicResource PrimaryBackgroundBrush}"
                                                  Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                  AlternatingRowBackground="{DynamicResource SecondaryBackgroundBrush}"
                                                  Background="{DynamicResource EditorBackgroundBrush}"
                                                  BorderBrush="{DynamicResource BorderBrush}"
                                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                                  FontFamily="Consolas"
                                                  FontSize="12"
                                                  MaxHeight="250"
                                                  Margin="0,0,0,16">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*"/>
                                                <DataGridTextColumn Header="Count" Binding="{Binding Count, StringFormat=N0}" Width="120">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        
                                        <!-- Edge Labels -->
                                        <TextBlock Text="Edge Labels" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,0,8"/>
                                        <DataGrid ItemsSource="{Binding EdgeLabelCounts}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  GridLinesVisibility="Horizontal"
                                                  RowBackground="{DynamicResource PrimaryBackgroundBrush}"
                                                  Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                  AlternatingRowBackground="{DynamicResource SecondaryBackgroundBrush}"
                                                  Background="{DynamicResource EditorBackgroundBrush}"
                                                  BorderBrush="{DynamicResource BorderBrush}"
                                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                                  FontFamily="Consolas"
                                                  FontSize="12"
                                                  MaxHeight="250">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*"/>
                                                <DataGridTextColumn Header="Count" Binding="{Binding Count, StringFormat=N0}" Width="120">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </GroupBox>
                                    </Grid>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Border>
            </Grid>
        </Grid>
    </DockPanel>
    </Grid>
    
    <!-- Welcome Guide Overlay (topmost layer) -->
    <controls:WelcomeGuideOverlay Grid.Row="0" Grid.RowSpan="2"
                                   DataContext="{Binding WelcomeGuide}"/>
</Grid>
</Border>
</Window>
