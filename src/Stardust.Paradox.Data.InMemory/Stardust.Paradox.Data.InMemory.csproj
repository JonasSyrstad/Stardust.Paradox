<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		
		<!-- Package Information -->
		<PackageId>Stardust.Paradox.Data.InMemory</PackageId>
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<Authors>Stardust</Authors>
		<Company>Stardust</Company>
		<Product>Stardust.Paradox.Data.InMemory</Product>
		<Title>Stardust Paradox InMemory Graph Database</Title>
		<Summary>Production-ready in-memory Gremlin graph database implementation for testing, development, and debugging</Summary>
		<Description>A comprehensive, production-ready in-memory Gremlin-compatible graph database implementation for Stardust.Paradox.Data. Ideal for unit testing, integration testing, rapid prototyping, and production debugging. Features a powerful scenario framework for easy test data setup, full Gremlin query support, WebSocket and TCP endpoints, built-in Gremlin server compatible with standard Gremlin.Net clients, and seamless integration with existing Paradox applications.</Description>
		<Copyright>Copyright © Stardust 2021-2024</Copyright>
		
		<!-- Package Metadata -->
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/JonasSyrstad/Stardust.Paradox</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/JonasSyrstad/Stardust.Paradox</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<RepositoryBranch>main</RepositoryBranch>
		<PackageTags>Gremlin;InMemory;Graph;Database;Testing;TinkerPop;GraphDB;Unit-Testing;Integration-Testing;Scenario-Framework;Stardust;Paradox;WebSocket;GremlinNet;GremlinServer</PackageTags>
		<PackageReleaseNotes>GA Release 1.0.0: Production-ready in-memory Gremlin database with comprehensive TinkerPop protocol support. Features include: built-in Gremlin server compatible with standard Gremlin.Net clients, WebSocket and TCP endpoint support (.NET 8+), comprehensive scenario framework for test data setup, built-in scenarios for Social Network, E-Commerce, Organization, and User Management, fluent API for easy connector creation and configuration, custom scenario support with extensible provider pattern, high-performance graph traversals and aggregations, production debugging capabilities with scenario export from CosmosDB, complete TinkerPop 3.x compatibility, comprehensive documentation and usage examples. Compatible with .NET Standard 2.0 and .NET 8+.</PackageReleaseNotes>
		
		<!-- Build Configuration -->
		<Deterministic>true</Deterministic>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
		
		<!-- Development Dependencies -->
		<DevelopmentDependency>false</DevelopmentDependency>
		<IsPackable>true</IsPackable>
		
		<!-- Package Classification -->
		<PackageType>Dependency</PackageType>
		<ContentTargetFolders>content</ContentTargetFolders>
	</PropertyGroup>

	<!-- Package Dependencies -->
	<ItemGroup>
		<PackageReference Include="Gremlin.Net" Version="3.4.10" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
		<PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1" PrivateAssets="All" />
	</ItemGroup>
	
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.0" />
	</ItemGroup>
	
	<!-- Project Dependencies -->
	<ItemGroup>
		<ProjectReference Include="..\Stardust.Paradox.Data\Stardust.Paradox.Data.csproj" PrivateAssets="None" />
	</ItemGroup>

	<!-- Package Content -->
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
		<None Include="SCENARIO_FRAMEWORK_README.md" Pack="true" PackagePath="docs\" Condition="Exists('SCENARIO_FRAMEWORK_README.md')" />
		<None Include="SCENARIO_FRAMEWORK_IMPLEMENTATION_SUMMARY.md" Pack="true" PackagePath="docs\" Condition="Exists('SCENARIO_FRAMEWORK_IMPLEMENTATION_SUMMARY.md')" />
		<None Include="TESTING_GUIDE.md" Pack="true" PackagePath="docs\" Condition="Exists('TESTING_GUIDE.md')" />
		<None Include="NUGET_PUBLISHING_GUIDE.md" Pack="true" PackagePath="docs\" Condition="Exists('NUGET_PUBLISHING_GUIDE.md')" />
		<None Include="GREMLIN_SERVER_USAGE.md" Pack="true" PackagePath="docs\" Condition="Exists('GREMLIN_SERVER_USAGE.md')" />
	</ItemGroup>

	<!-- Conditional Framework References -->
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="System.ComponentModel.Annotations" Version="4.7.0" />
	</ItemGroup>

</Project>
